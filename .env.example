# Variables de proceso FastAPI; no se carga este archivo automaticamente.
# Docker local usa .env.docker generado por infra/scripts/Initialize-LocalEnvironment.ps1.
HDB_APP_NAME=HDBoutique API
HDB_ENVIRONMENT=development
HDB_DEBUG=False
# Habilitar tras migrar y crear administrador en destino autorizado.
HDB_BUSINESS_API_ENABLED=False
HDB_AUTH_ORIGIN=http://127.0.0.1:8080
# True requiere HTTPS. False se permite solo en development/test para ensayo HTTP.
HDB_SESSION_COOKIE_SECURE=True
