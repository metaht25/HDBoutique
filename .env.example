# Copia este archivo como .env en la raiz del proyecto.
# No subas tu archivo .env real a GitHub.

SECRET_KEY=django-insecure-cambia-esta-clave-en-tu-equipo
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=HDBoutique
DB_HOST=TU-SERVIDOR\SQLEXPRESS
DB_PORT=
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUSTED_CONNECTION=yes

# FastAPI: variables independientes; no carga este archivo automaticamente.
HDB_APP_NAME=HDBoutique API
HDB_ENVIRONMENT=development
HDB_DEBUG=False
# Fase 8: habilitar solo tras migrar y crear administrador en destino autorizado.
HDB_BUSINESS_API_ENABLED=False
HDB_AUTH_ORIGIN=http://localhost:8001
# True requiere HTTPS. False se permite solo en development/test para ensayo HTTP.
HDB_SESSION_COOKIE_SECURE=True
